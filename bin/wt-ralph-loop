#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///

"""Run plan phases as interactive Claude tabs in the current Herdr workspace."""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import time
from collections.abc import Callable
from datetime import datetime, timezone
from pathlib import Path
from typing import NamedTuple
from uuid import uuid4


class PlanError(ValueError):
    """The plan does not satisfy the wt-ralph-loop contract."""


class LoopError(RuntimeError):
    """The loop cannot safely continue."""


class ClaudeError(LoopError):
    """Claude did not produce a successful phase report."""


class Phase(NamedTuple):
    number: int
    title: str
    issue: str
    complete: bool


PHASE_RE = re.compile(r"^### Phase (\d+):\s*(.+)$", re.MULTILINE)
WRONG_PHASE_RE = re.compile(r"^## Phase \d+:", re.MULTILINE)
SUBTASK_RE = re.compile(r"^\*\*Subtask\*\*:\s*([A-Z]+-\d+)\b.*$", re.MULTILINE)
CHECKBOX_RE = re.compile(r"^- \[([ x])\]\s+.+$", re.MULTILINE)


def section(body: str, phase_number: int, heading: str) -> str:
    match = re.search(
        rf"^#### {re.escape(heading)}\s*$\n(.*?)(?=^#### |\Z)",
        body,
        re.MULTILINE | re.DOTALL,
    )
    if match is None:
        raise PlanError(f"Phase {phase_number} is missing {heading}")
    return match.group(1)


def checkboxes(text: str, phase_number: int, heading: str) -> list[str]:
    malformed = [
        line
        for line in text.splitlines()
        if line.startswith("- [") and CHECKBOX_RE.fullmatch(line) is None
    ]
    if malformed:
        raise PlanError(
            f"Phase {phase_number} has a malformed checkbox under {heading}: "
            f"{malformed[0]}"
        )
    states = CHECKBOX_RE.findall(text)
    if not states:
        raise PlanError(f"Phase {phase_number} has no checkboxes under {heading}")
    return states


def parse_phase(match: re.Match[str], body: str) -> Phase:
    number = int(match.group(1))
    title = match.group(2).strip()
    subtasks = SUBTASK_RE.findall(body)
    if len(subtasks) != 1:
        raise PlanError(f"Phase {number} must contain exactly one Subtask")

    section(body, number, "Pull Request Description")
    tdd = section(body, number, "TDD Cycles")
    cycle_matches = list(re.finditer(r"^##### Cycle (\d+):\s*.+$", tdd, re.MULTILINE))
    if not cycle_matches:
        raise PlanError(f"Phase {number} has no cycles under TDD Cycles")
    checkboxes(tdd, number, "TDD Cycles")
    states = []
    for index, cycle in enumerate(cycle_matches):
        end = (
            cycle_matches[index + 1].start()
            if index + 1 < len(cycle_matches)
            else len(tdd)
        )
        cycle_states = re.findall(
            r"^- \[([ x])\] Complete\s*$",
            tdd[cycle.end() : end],
            re.MULTILINE,
        )
        if len(cycle_states) != 1:
            raise PlanError(
                f"Phase {number} Cycle {cycle.group(1)} must contain exactly one "
                "completion checkbox"
            )
        states.extend(cycle_states)

    automated = section(body, number, "Automated Testing")
    states.extend(checkboxes(automated, number, "Automated Testing"))
    if re.search(r"^\*\*Run:\*\*\s*\S.*$", automated, re.MULTILINE) is None:
        raise PlanError(f"Phase {number} is missing Run under Automated Testing")

    done = section(body, number, "Done When")
    states.extend(checkboxes(done, number, "Done When"))

    return Phase(number, title, subtasks[0], all(state == "x" for state in states))


def parse_plan(text: str) -> list[Phase]:
    if WRONG_PHASE_RE.search(text):
        raise PlanError("invalid phase heading; expected '### Phase N:'")

    matches = list(PHASE_RE.finditer(text))
    if not matches:
        raise PlanError("plan has no '### Phase N:' sections")

    phases = []
    for index, match in enumerate(matches):
        end = matches[index + 1].start() if index + 1 < len(matches) else len(text)
        phases.append(parse_phase(match, text[match.end() : end]))
    return phases


def next_phase(phases: list[Phase]) -> Phase | None:
    return next((phase for phase in phases if not phase.complete), None)


def command_output(args: list[str], cwd: Path) -> str:
    return subprocess.run(
        args,
        cwd=cwd,
        text=True,
        stdout=subprocess.PIPE,
        check=True,
    ).stdout.strip()


def current_branch(worktree: Path) -> str:
    branch = command_output(["git", "branch", "--show-current"], worktree)
    if not branch:
        raise LoopError(f"detached HEAD in {worktree}")
    return branch


def machete_branches(worktree: Path) -> set[str]:
    layout = Path(command_output(["git", "machete", "file"], worktree))
    return {
        line.strip().split()[0]
        for line in layout.read_text().splitlines()
        if line.strip() and not line.lstrip().startswith("#")
    }


def worktrees(worktree: Path) -> dict[Path, str]:
    output = command_output(["git", "worktree", "list", "--porcelain"], worktree)
    found: dict[Path, str] = {}
    path: Path | None = None
    for line in output.splitlines():
        if line.startswith("worktree "):
            path = Path(line.removeprefix("worktree "))
        elif line.startswith("branch refs/heads/") and path is not None:
            found[path] = line.removeprefix("branch refs/heads/")
            path = None
    return found


def herdr_json(args: list[str], cwd: Path) -> dict[str, object]:
    command = ["herdr", *args]
    try:
        output = subprocess.run(
            command,
            cwd=cwd,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            check=True,
        ).stdout
    except subprocess.CalledProcessError as error:
        detail = error.stderr.strip() or f"status {error.returncode}"
        raise ClaudeError(f"{' '.join(command[:3])} failed: {detail}") from error
    except OSError as error:
        raise ClaudeError(f"{' '.join(command[:3])} could not start: {error}") from error

    try:
        response = json.loads(output)
    except json.JSONDecodeError as error:
        raise ClaudeError(f"{' '.join(command[:3])} returned invalid JSON") from error
    if not isinstance(response, dict) or not isinstance(response.get("result"), dict):
        raise ClaudeError(f"{' '.join(command[:3])} returned an invalid response")
    return response


def response_item(response: dict[str, object], key: str) -> dict[str, object]:
    result = response["result"]
    assert isinstance(result, dict)
    item = result.get(key)
    if not isinstance(item, dict):
        raise ClaudeError(f"Herdr response is missing {key}")
    return item


def phase_complete(plan_path: Path, phase_number: int) -> bool:
    phase = next(
        (item for item in parse_plan(plan_path.read_text()) if item.number == phase_number),
        None,
    )
    return phase is not None and phase.complete


def agent_name(selected: Phase, session_id: str) -> str:
    suffix = f"-{session_id[:8]}"
    prefix = f"p{selected.number}-"
    if len(prefix) + len(suffix) >= 32:
        prefix = f"p{str(selected.number)[-8:]}-"
    issue_length = 32 - len(prefix) - len(suffix)
    return f"{prefix}{selected.issue.lower()[:issue_length]}{suffix}"


def run_claude(
    selected: Phase, worktree: Path, plan_path: Path, run_dir: Path
) -> None:
    run_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    metadata_path = run_dir / f"phase-{selected.number}-{selected.issue}.json"
    session_id = str(uuid4())
    name = agent_name(selected, session_id)
    workspace_id = os.environ["HERDR_WORKSPACE_ID"]
    metadata: dict[str, object] = {
        "phase": selected.number,
        "issue": selected.issue,
        "sessionId": session_id,
        "agentName": name,
        "workspaceId": workspace_id,
        "worktree": str(worktree),
        "status": "running",
        "createdAt": utc_now(),
    }
    metadata_path.write_text(json.dumps(metadata, indent=2) + "\n")

    try:
        created = herdr_json(
            [
                "tab",
                "create",
                "--workspace",
                workspace_id,
                "--cwd",
                str(worktree),
                "--label",
                selected.issue,
                "--focus",
            ],
            worktree,
        )
        tab = response_item(created, "tab")
        pane = response_item(created, "root_pane")
        tab_id = tab.get("tab_id")
        pane_id = pane.get("pane_id")
        if not isinstance(tab_id, str) or not isinstance(pane_id, str):
            raise ClaudeError("Herdr tab creation returned invalid identifiers")
        metadata.update({"tabId": tab_id, "paneId": pane_id})
        metadata_path.write_text(json.dumps(metadata, indent=2) + "\n")

        herdr_json(
            [
                "agent",
                "start",
                name,
                "--kind",
                "claude",
                "--pane",
                pane_id,
                "--",
                "--permission-mode",
                "auto",
                "--session-id",
                session_id,
            ],
            worktree,
        )
        herdr_json(
            [
                "agent",
                "prompt",
                name,
                f"/implement-next-phase {plan_path}",
                "--wait",
            ],
            worktree,
        )

        status: str | None = None
        correction_reported = False
        while True:
            try:
                if status is None:
                    response = herdr_json(["agent", "get", name], worktree)
                else:
                    response = herdr_json(["agent", "wait", name], worktree)
                agent = response_item(response, "agent")
            except ClaudeError as error:
                raise ClaudeError(f"Claude agent {name} is unavailable: {error}") from error

            status = agent.get("agent_status")
            if not isinstance(status, str):
                raise ClaudeError("Herdr returned Claude without an agent status")
            complete = phase_complete(plan_path, selected.number)
            if status in {"idle", "done"} and complete:
                break
            if status == "working":
                correction_reported = False
                continue
            if status not in {"idle", "done", "blocked", "unknown"}:
                raise ClaudeError(f"Claude entered unsupported state {status!r}")

            metadata["status"] = "needs-correction"
            metadata["updatedAt"] = utc_now()
            metadata_path.write_text(json.dumps(metadata, indent=2) + "\n")
            if not correction_reported:
                print(
                    f"Phase {selected.number} needs correction in Herdr tab {tab_id}.",
                    file=sys.stderr,
                    flush=True,
                )
                correction_reported = True
            status = None
            time.sleep(0.5)
    except (ClaudeError, PlanError, OSError, UnicodeError):
        metadata["status"] = "failed"
        metadata["completedAt"] = utc_now()
        metadata_path.write_text(json.dumps(metadata, indent=2) + "\n")
        raise

    metadata["status"] = "succeeded"
    metadata["completedAt"] = utc_now()
    metadata_path.write_text(json.dumps(metadata, indent=2) + "\n")


def run_loop(
    plan_path: Path,
    *,
    start_dir: Path,
    run_dir: Path,
    claude_runner: Callable[[Phase, Path, Path, Path], None] = run_claude,
) -> int:
    if os.environ.get("HERDR_ENV") != "1" or not os.environ.get(
        "HERDR_WORKSPACE_ID"
    ):
        raise LoopError("wt ralph-loop must run inside Herdr")

    plan_path = plan_path.expanduser().resolve()
    if not plan_path.is_file():
        raise PlanError(f"plan file does not exist: {plan_path}")
    phases = parse_plan(plan_path.read_text())
    if next_phase(phases) is None:
        return 0

    parent_path = start_dir.resolve()
    parent_branch = current_branch(parent_path)
    if parent_branch not in machete_branches(parent_path):
        raise LoopError(
            f"starting branch {parent_branch!r} is not registered in git machete; "
            "register it before running wt ralph-loop"
        )

    phases_completed = 0
    while selected := next_phase(phases):
        before = worktrees(parent_path)
        try:
            subprocess.run(["wt", "jira", selected.issue], cwd=parent_path, check=True)
        except subprocess.CalledProcessError as error:
            raise LoopError(
                f"wt jira {selected.issue} failed with status {error.returncode}"
            ) from error
        added = worktrees(parent_path).items() - before.items()
        if len(added) != 1:
            raise LoopError(
                f"wt jira {selected.issue} created {len(added)} worktrees, expected one"
            )
        child_path, child_branch = added.pop()
        try:
            subprocess.run(
                [
                    "git",
                    "machete",
                    "add",
                    child_branch,
                    f"--onto={parent_branch}",
                    "--yes",
                ],
                cwd=child_path,
                check=True,
            )
        except subprocess.CalledProcessError as error:
            raise LoopError(
                f"git machete could not register {child_branch!r} onto "
                f"{parent_branch!r}; worktree preserved at {child_path}"
            ) from error

        try:
            claude_runner(selected, child_path, plan_path, run_dir)
            phases = parse_plan(plan_path.read_text())
        except PlanError as error:
            raise LoopError(
                f"plan became invalid after Phase {selected.number}: {error}; "
                f"worktree preserved at {child_path}"
            ) from error
        updated = next(
            (phase for phase in phases if phase.number == selected.number), None
        )
        if updated is None or not updated.complete:
            raise LoopError(
                f"Claude exited without completing Phase {selected.number} "
                f"({selected.issue}); worktree preserved at {child_path}"
            )
        phases_completed += 1
        parent_path = child_path
        parent_branch = child_branch

    return phases_completed


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat()


def write_state(path: Path, state: dict[str, object]) -> None:
    temporary = path.with_name(f".{path.name}.tmp")
    temporary.write_text(json.dumps(state, indent=2) + "\n")
    temporary.replace(path)


def create_run_dir() -> Path:
    state_home = Path(
        os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")
    ).expanduser()
    run_dir = state_home / "ralph-loop" / "runs" / str(uuid4())
    run_dir.mkdir(mode=0o700, parents=True)
    return run_dir


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog="wt ralph-loop",
        usage="wt ralph-loop PLAN-FILE",
        description=(
            "Implement every incomplete phase as a stack of worktrees and "
            "interactive Claude tabs in the current workspace. Run inside Herdr."
        ),
        epilog=(
            "PLAN-FILE must use the manually processed '### Phase N:' format. "
            "The starting branch must already be registered in git machete. "
            "Each phase tab remains open after completion or failure. Run metadata "
            "is stored below ${XDG_STATE_HOME:-~/.local/state}/ralph-loop/runs. "
            "On failure, branches, worktrees, changes, tabs, and sessions are preserved."
        ),
    )
    parser.add_argument("plan_file", type=Path, metavar="PLAN-FILE")
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    run_dir = create_run_dir()
    state_path = run_dir / "run.json"
    state: dict[str, object] = {
        "status": "running",
        "createdAt": utc_now(),
        "cwd": str(Path.cwd()),
        "planFile": str(args.plan_file.expanduser().resolve()),
    }
    write_state(state_path, state)

    try:
        phases_completed = run_loop(
            args.plan_file,
            start_dir=Path.cwd(),
            run_dir=run_dir,
        )
    except KeyboardInterrupt:
        state["status"] = "interrupted"
        state["completedAt"] = utc_now()
        write_state(state_path, state)
        print("\nInterrupted", file=sys.stderr)
        print(f"run log: {run_dir}", file=sys.stderr)
        return 130
    except (
        PlanError,
        LoopError,
        subprocess.CalledProcessError,
        OSError,
        UnicodeError,
    ) as error:
        state["status"] = "failed"
        state["completedAt"] = utc_now()
        state["error"] = str(error)
        write_state(state_path, state)
        print(f"error: {error}", file=sys.stderr)
        print(f"run log: {run_dir}", file=sys.stderr)
        return 1

    state["status"] = "completed"
    state["completedAt"] = utc_now()
    state["phasesCompleted"] = phases_completed
    write_state(state_path, state)
    if phases_completed == 0:
        print("Plan has no incomplete phases.")
    print(f"run log: {run_dir}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print("\nInterrupted", file=sys.stderr)
        raise SystemExit(130) from None
