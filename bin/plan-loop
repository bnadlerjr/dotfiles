#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///

"""Iteratively review and revise an agent-generated plan with Plannotator.

Usage:
    plan-loop <prompt.md>

The prompt file is sent to Pi, and Pi's Markdown response is opened in
Plannotator. If annotations are submitted, their feedback is sent back to the
same Pi session and the complete revised response is opened for review again.
The loop ends when the response is approved or dismissed. The final response is
written to stdout; Pi progress and tool activity are written to stderr.

Each invocation stores its run metadata, reviewed response, and isolated Pi
session under:

    ${XDG_STATE_HOME:-~/.local/state}/plan-loop/runs/<run-id>/

Plannotator revision history works within a run because every response revision
reuses that run's response.md path. Run state is retained after the command
exits and may contain sensitive prompts, responses, feedback, and tool results.
"""

import json
import os
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import NoReturn
from uuid import uuid4


def die(message: str, exit_code: int = 1) -> NoReturn:
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(exit_code)


def require_command(name: str) -> None:
    if shutil.which(name) is None:
        die(f"'{name}' not found in PATH")


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat()


def create_run(prompt_file: Path) -> tuple[Path, dict[str, object]]:
    state_home = Path(
        os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")
    ).expanduser()
    run_id = str(uuid4())
    run_dir = state_home / "plan-loop" / "runs" / run_id
    run_dir.mkdir(mode=0o700, parents=True)

    state: dict[str, object] = {
        "version": 1,
        "id": run_id,
        "harness": "pi",
        "status": "running",
        "createdAt": utc_now(),
        "cwd": str(Path.cwd()),
        "promptFile": str(prompt_file.resolve()),
        "session": {
            "kind": "pi-session-directory",
            "path": "harness/pi/sessions",
        },
    }
    write_run_state(run_dir, state)
    return run_dir, state


def write_run_state(run_dir: Path, state: dict[str, object]) -> None:
    destination = run_dir / "run.json"
    temporary = run_dir / ".run.json.tmp"
    temporary.write_text(json.dumps(state, indent=2, ensure_ascii=False) + "\n")
    temporary.replace(destination)


def find_pi_session(session_dir: Path) -> Path:
    sessions = list(session_dir.glob("*.jsonl"))
    if len(sessions) != 1:
        die(f"expected one pi session in {session_dir}, found {len(sessions)}")
    return sessions[0]


def assistant_text(event: dict[str, object]) -> str | None:
    message = event.get("message")
    if not isinstance(message, dict) or message.get("role") != "assistant":
        return None

    content = message.get("content")
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return None

    return "".join(
        block.get("text", "")
        for block in content
        if isinstance(block, dict)
        and block.get("type") == "text"
        and isinstance(block.get("text"), str)
    )


def describe_tool_call(event: dict[str, object]) -> None:
    name = event.get("toolName", "unknown")
    args = event.get("args")
    details = json.dumps(args, ensure_ascii=False, separators=(",", ":"))
    if len(details) > 500:
        details = f"{details[:497]}..."
    print(f"[pi] → {name} {details}", file=sys.stderr, flush=True)


def run_pi(message: str, session_dir: Path, *, session_file: Path | None) -> str:
    command = ["pi", "--mode", "json", "--session-dir", str(session_dir)]
    if session_file is not None:
        command.extend(["--session", str(session_file)])

    process = subprocess.Popen(
        command,
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        text=True,
        bufsize=1,
    )
    assert process.stdin is not None
    assert process.stdout is not None
    process.stdin.write(message)
    process.stdin.close()

    print("[pi] working...", file=sys.stderr, flush=True)
    output: str | None = None
    thinking_active = False
    thinking_ends_with_newline = False
    for line in process.stdout:
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            process.terminate()
            die("pi returned an invalid JSON event")
        if not isinstance(event, dict):
            continue

        event_type = event.get("type")
        if event_type == "message_update":
            update = event.get("assistantMessageEvent")
            if not isinstance(update, dict):
                continue
            update_type = update.get("type")
            if update_type == "thinking_start":
                sys.stderr.write("[pi] thinking: ")
                sys.stderr.flush()
                thinking_active = True
                thinking_ends_with_newline = False
            elif update_type == "thinking_delta":
                delta = update.get("delta")
                if not isinstance(delta, str):
                    continue
                if not thinking_active:
                    sys.stderr.write("[pi] thinking: ")
                    thinking_active = True
                sys.stderr.write(delta)
                sys.stderr.flush()
                thinking_ends_with_newline = delta.endswith("\n")
            elif update_type == "thinking_end" and thinking_active:
                if not thinking_ends_with_newline:
                    sys.stderr.write("\n")
                sys.stderr.flush()
                thinking_active = False
        elif event_type == "tool_execution_start":
            describe_tool_call(event)
        elif event_type == "tool_execution_end":
            name = event.get("toolName", "unknown")
            status = "failed" if event.get("isError") else "done"
            print(f"[pi] ← {name} {status}", file=sys.stderr, flush=True)
        elif event_type == "message_end":
            text = assistant_text(event)
            if text is not None:
                output = text

    if thinking_active and not thinking_ends_with_newline:
        sys.stderr.write("\n")
        sys.stderr.flush()

    return_code = process.wait()
    if return_code != 0:
        die(f"pi exited with status {return_code}", return_code)
    if output is None or not output.strip():
        die("pi returned an empty response")
    return output


def revision_prompt(feedback: str, prompt_file: Path, review_file: Path) -> str:
    return f"""The text below is review feedback on your previous assistant response.
Revise that response and return the complete replacement as your final assistant
message. Do not edit the annotated response file ({review_file}) or the source
prompt file ({prompt_file}). You may still use tools and modify other project
files when needed to fulfill the original task. Do not wrap the complete response
in a Markdown code fence.

{feedback}"""


def request_review(output: str, review_file: Path) -> dict[str, object]:
    review_file.write_text(output)
    result = subprocess.run(
        ["plannotator", "annotate", str(review_file), "--gate", "--json"],
        text=True,
        stdout=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        die(
            f"plannotator exited with status {result.returncode}",
            result.returncode,
        )

    try:
        decision = json.loads(result.stdout)
    except json.JSONDecodeError:
        die("plannotator returned invalid JSON")
    if not isinstance(decision, dict):
        die("plannotator returned an unexpected result")
    return decision


def main() -> None:
    if len(sys.argv) != 2:
        die(f"usage: {Path(sys.argv[0]).name} <prompt.md>")

    prompt_file = Path(sys.argv[1]).expanduser()
    if not prompt_file.is_file():
        die(f"prompt file does not exist: {prompt_file}")

    try:
        prompt = prompt_file.read_text()
    except (OSError, UnicodeError) as error:
        die(f"cannot read prompt file: {error}")
    if not prompt.strip():
        die("prompt file is empty")

    require_command("pi")
    require_command("plannotator")

    run_dir, run_state = create_run(prompt_file)
    session_dir = run_dir / "harness" / "pi" / "sessions"
    session_dir.mkdir(parents=True)
    output = run_pi(prompt, session_dir, session_file=None)
    session_file = find_pi_session(session_dir)
    run_state["session"] = {
        "kind": "pi-session-file",
        "path": str(session_file.relative_to(run_dir)),
    }
    write_run_state(run_dir, run_state)
    review_file = run_dir / "response.md"

    while True:
        result = request_review(output, review_file)
        decision = result.get("decision")

        if decision in {"approved", "dismissed"}:
            run_state["status"] = "completed"
            run_state["decision"] = decision
            run_state["completedAt"] = utc_now()
            write_run_state(run_dir, run_state)
            sys.stdout.write(output)
            return
        if decision != "annotated":
            die(f"unknown plannotator decision: {decision!r}")

        feedback = result.get("feedback")
        if not isinstance(feedback, str) or not feedback.strip():
            die("plannotator returned an annotation without feedback")
        output = run_pi(
            revision_prompt(feedback, prompt_file, review_file),
            session_dir,
            session_file=session_file,
        )


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nInterrupted", file=sys.stderr)
        raise SystemExit(130) from None
