#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///

"""Iteratively review and revise an agent-generated plan with Plannotator.

Usage:
    plan-loop --prompt <prompt.md>
    plan-loop --stdin < prompt.md
    plan-loop --harness claude --prompt <prompt.md>
    plan-loop --harness opencode --prompt <prompt.md>

The prompt is read from a file or from standard input and sent to the harness.
The harness response is opened in Plannotator. If annotations are submitted,
their feedback is sent back to the same harness session and the complete revised
response is opened for review again. The loop ends when the response is approved
or dismissed. The final response is written to stdout; harness progress and tool
activity are written to stderr.

The --harness option selects the agent: pi, claude, or opencode. The option has
priority. If the option is absent, the AGENT_HARNESS environment variable selects
the agent. If that variable is empty or unset, the harness is pi.

Each invocation stores its run metadata and reviewed response under:

    ${XDG_STATE_HOME:-~/.local/state}/plan-loop/runs/<run-id>/

A pi run keeps its session in that directory. Claude Code writes its session in
its own configuration directory, and run.json records that path. opencode keeps
its sessions in one database, and run.json records the database path.

Plannotator revision history works within a run because every response revision
reuses that run's response.md path. Run state is retained after the command
exits and may contain sensitive prompts, responses, feedback, and tool results.
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import NoReturn
from uuid import uuid4


HARNESSES = ("pi", "claude", "opencode")
PI_SESSION_PATH = "harness/pi/sessions"


def die(message: str, exit_code: int = 1) -> NoReturn:
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(exit_code)


def require_command(name: str) -> None:
    if shutil.which(name) is None:
        die(f"'{name}' not found in PATH")


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat()


def resolve_harness(selected: str | None) -> str:
    if selected is not None:
        return selected
    configured = os.environ.get("AGENT_HARNESS", "").strip()
    if not configured:
        return "pi"
    if configured not in HARNESSES:
        die(
            f"AGENT_HARNESS must be one of {', '.join(HARNESSES)}, "
            f"not {configured!r}"
        )
    return configured


def read_prompt_file(prompt_file: Path) -> str:
    if not prompt_file.is_file():
        die(f"prompt file does not exist: {prompt_file}")
    try:
        prompt = prompt_file.read_text()
    except (OSError, UnicodeError) as error:
        die(f"cannot read prompt file: {error}")
    if not prompt.strip():
        die("prompt file is empty")
    return prompt


def read_prompt_stdin() -> str:
    try:
        prompt = sys.stdin.read()
    except (OSError, UnicodeError) as error:
        die(f"cannot read prompt from stdin: {error}")
    if not prompt.strip():
        die("prompt on stdin is empty")
    return prompt


def opencode_database() -> Path | None:
    data_home = Path(
        os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share")
    ).expanduser()
    database = data_home / "opencode" / "opencode.db"
    # opencode owns this file, so a missing database must not end the loop.
    return database if database.is_file() else None


def opencode_session(session_id: str | None) -> dict[str, object]:
    database = opencode_database()
    return {
        "kind": "opencode-session-id",
        "id": session_id,
        "database": str(database) if database is not None else None,
    }


def initial_session(harness: str) -> dict[str, object]:
    if harness == "pi":
        return {"kind": "pi-session-directory", "path": PI_SESSION_PATH}
    if harness == "claude":
        return {"kind": "claude-session-id", "id": None, "transcript": None}
    return opencode_session(None)


def create_run(
    prompt_file: Path | None, harness: str
) -> tuple[Path, dict[str, object]]:
    state_home = Path(
        os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")
    ).expanduser()
    run_id = str(uuid4())
    run_dir = state_home / "plan-loop" / "runs" / run_id
    run_dir.mkdir(mode=0o700, parents=True)

    state: dict[str, object] = {
        "version": 1,
        "id": run_id,
        "harness": harness,
        "status": "running",
        "createdAt": utc_now(),
        "cwd": str(Path.cwd()),
        "promptFile": str(prompt_file.resolve()) if prompt_file is not None else None,
        "session": initial_session(harness),
    }
    write_run_state(run_dir, state)
    return run_dir, state


def write_run_state(run_dir: Path, state: dict[str, object]) -> None:
    destination = run_dir / "run.json"
    temporary = run_dir / ".run.json.tmp"
    temporary.write_text(json.dumps(state, indent=2, ensure_ascii=False) + "\n")
    temporary.replace(destination)


def find_pi_session(session_dir: Path) -> Path:
    sessions = list(session_dir.glob("*.jsonl"))
    if len(sessions) != 1:
        die(f"expected one pi session in {session_dir}, found {len(sessions)}")
    return sessions[0]


def find_claude_session(session_id: str) -> Path | None:
    config_home = Path(
        os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude")
    ).expanduser()
    transcripts = list((config_home / "projects").glob(f"*/{session_id}.jsonl"))
    # The transcript belongs to Claude Code, not to the run, so a moved or
    # missing file must not end an otherwise healthy loop.
    if len(transcripts) != 1:
        return None
    return transcripts[0]


def assistant_text(event: dict[str, object]) -> str | None:
    message = event.get("message")
    if not isinstance(message, dict) or message.get("role") != "assistant":
        return None

    content = message.get("content")
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return None

    return "".join(
        block.get("text", "")
        for block in content
        if isinstance(block, dict)
        and block.get("type") == "text"
        and isinstance(block.get("text"), str)
    )


def truncated_args(args: object) -> str:
    details = json.dumps(args, ensure_ascii=False, separators=(",", ":"))
    if len(details) > 500:
        details = f"{details[:497]}..."
    return details


def describe_tool_call(harness: str, name: object, args: object) -> None:
    print(
        f"[{harness}] → {name} {truncated_args(args)}", file=sys.stderr, flush=True
    )


def message_blocks(event: dict[str, object]) -> list[dict[str, object]]:
    message = event.get("message")
    if not isinstance(message, dict):
        return []
    content = message.get("content")
    if not isinstance(content, list):
        return []
    return [block for block in content if isinstance(block, dict)]


def start_harness(command: list[str], message: str) -> "subprocess.Popen[str]":
    process = subprocess.Popen(
        command,
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        text=True,
        bufsize=1,
    )
    assert process.stdin is not None
    assert process.stdout is not None
    process.stdin.write(message)
    process.stdin.close()
    return process


def run_pi(message: str, session_dir: Path, *, session_file: Path | None) -> str:
    command = ["pi", "--mode", "json", "--session-dir", str(session_dir)]
    if session_file is not None:
        command.extend(["--session", str(session_file)])

    process = start_harness(command, message)
    assert process.stdout is not None

    print("[pi] working...", file=sys.stderr, flush=True)
    output: str | None = None
    thinking_active = False
    thinking_ends_with_newline = False
    for line in process.stdout:
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            process.terminate()
            die("pi returned an invalid JSON event")
        if not isinstance(event, dict):
            continue

        event_type = event.get("type")
        if event_type == "message_update":
            update = event.get("assistantMessageEvent")
            if not isinstance(update, dict):
                continue
            update_type = update.get("type")
            if update_type == "thinking_start":
                sys.stderr.write("[pi] thinking: ")
                sys.stderr.flush()
                thinking_active = True
                thinking_ends_with_newline = False
            elif update_type == "thinking_delta":
                delta = update.get("delta")
                if not isinstance(delta, str):
                    continue
                if not thinking_active:
                    sys.stderr.write("[pi] thinking: ")
                    thinking_active = True
                sys.stderr.write(delta)
                sys.stderr.flush()
                thinking_ends_with_newline = delta.endswith("\n")
            elif update_type == "thinking_end" and thinking_active:
                if not thinking_ends_with_newline:
                    sys.stderr.write("\n")
                sys.stderr.flush()
                thinking_active = False
        elif event_type == "tool_execution_start":
            describe_tool_call(
                "pi", event.get("toolName", "unknown"), event.get("args")
            )
        elif event_type == "tool_execution_end":
            name = event.get("toolName", "unknown")
            status = "failed" if event.get("isError") else "done"
            print(f"[pi] ← {name} {status}", file=sys.stderr, flush=True)
        elif event_type == "message_end":
            text = assistant_text(event)
            if text is not None:
                output = text

    if thinking_active and not thinking_ends_with_newline:
        sys.stderr.write("\n")
        sys.stderr.flush()

    return_code = process.wait()
    if return_code != 0:
        die(f"pi exited with status {return_code}", return_code)
    if output is None or not output.strip():
        die("pi returned an empty response")
    return output


def run_claude(message: str, *, session_id: str, resume: bool) -> str:
    # --safe-mode keeps the reviewed response free of hook and skill output from
    # the user configuration of this machine.
    command = [
        "claude",
        "-p",
        "--output-format",
        "stream-json",
        "--verbose",
        "--safe-mode",
        "--permission-mode",
        "dontAsk",
    ]
    command.extend(["--resume", session_id] if resume else ["--session-id", session_id])

    process = start_harness(command, message)
    assert process.stdout is not None

    print("[claude] working...", file=sys.stderr, flush=True)
    output: str | None = None
    tool_names: dict[object, object] = {}
    for line in process.stdout:
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            process.terminate()
            die("claude returned an invalid JSON event")
        if not isinstance(event, dict):
            continue

        event_type = event.get("type")
        if event_type == "assistant":
            for block in message_blocks(event):
                if block.get("type") != "tool_use":
                    continue
                name = block.get("name", "unknown")
                tool_names[block.get("id")] = name
                describe_tool_call("claude", name, block.get("input"))
        elif event_type == "user":
            for block in message_blocks(event):
                if block.get("type") != "tool_result":
                    continue
                name = tool_names.get(block.get("tool_use_id"), "unknown")
                # A successful tool result omits is_error.
                status = "failed" if block.get("is_error") else "done"
                print(f"[claude] ← {name} {status}", file=sys.stderr, flush=True)
        elif event_type == "result":
            text = event.get("result")
            if event.get("is_error"):
                process.terminate()
                die(f"claude reported an error: {text}")
            if isinstance(text, str):
                output = text

    return_code = process.wait()
    if return_code != 0:
        die(f"claude exited with status {return_code}", return_code)
    if output is None or not output.strip():
        die("claude returned an empty response")
    return output


def opencode_error(event: dict[str, object]) -> str:
    error = event.get("error")
    if not isinstance(error, dict):
        return "unknown error"
    data = error.get("data")
    message = data.get("message") if isinstance(data, dict) else None
    name = error.get("name", "error")
    return f"{name}: {message}" if message else str(name)


def run_opencode(message: str, *, session_id: str | None) -> tuple[str, str | None]:
    # opencode does not accept a session id. It reports the id it creates, and
    # the caller sends that id back to continue the same session.
    command = ["opencode", "run", "--format", "json", "--pure", "--auto"]
    if session_id is not None:
        command.extend(["-s", session_id])

    process = start_harness(command, message)
    assert process.stdout is not None

    print("[opencode] working...", file=sys.stderr, flush=True)
    captured = session_id
    output = ""
    text_message = None
    for line in process.stdout:
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            process.terminate()
            die("opencode returned an invalid JSON event")
        if not isinstance(event, dict):
            continue

        reported = event.get("sessionID")
        if isinstance(reported, str):
            captured = reported
        part = event.get("part")
        if not isinstance(part, dict):
            part = {}

        event_type = event.get("type")
        if event_type == "text":
            # Each step is a new message. The last message holds the answer, so
            # a new message starts the response again.
            if part.get("messageID") != text_message:
                text_message = part.get("messageID")
                output = ""
            text = part.get("text")
            if isinstance(text, str):
                output += text
        elif event_type == "tool_use":
            state = part.get("state")
            if not isinstance(state, dict):
                state = {}
            status = state.get("status", "unknown")
            print(
                f"[opencode] ← {part.get('tool', 'unknown')} "
                f"{'done' if status == 'completed' else status} "
                f"{truncated_args(state.get('input'))}",
                file=sys.stderr,
                flush=True,
            )
        elif event_type == "error":
            process.terminate()
            die(f"opencode reported an error: {opencode_error(event)}")

    return_code = process.wait()
    if return_code != 0:
        die(f"opencode exited with status {return_code}", return_code)
    if not output.strip():
        die("opencode returned an empty response")
    return output, captured


def revision_prompt(feedback: str, prompt_file: Path | None, review_file: Path) -> str:
    protected = f"the annotated response file ({review_file})"
    if prompt_file is not None:
        protected += f" or the source prompt file ({prompt_file})"

    return f"""The text below is review feedback on your previous assistant response.
Revise that response and return the complete replacement as your final assistant
message. Do not edit {protected}. You may still use tools and modify other
project files when needed to fulfill the original task. Do not wrap the complete
response in a Markdown code fence.

{feedback}"""


def request_review(output: str, review_file: Path) -> dict[str, object]:
    review_file.write_text(output)
    result = subprocess.run(
        ["plannotator", "annotate", str(review_file), "--gate", "--json"],
        text=True,
        stdout=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        die(
            f"plannotator exited with status {result.returncode}",
            result.returncode,
        )

    try:
        decision = json.loads(result.stdout)
    except json.JSONDecodeError:
        die("plannotator returned invalid JSON")
    if not isinstance(decision, dict):
        die("plannotator returned an unexpected result")
    return decision


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog=Path(sys.argv[0]).name,
        description=(
            "Iteratively review and revise an agent-generated plan with Plannotator."
        ),
    )
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument(
        "--prompt",
        type=Path,
        metavar="FILE",
        help="Markdown file holding the prompt to send to the harness",
    )
    source.add_argument(
        "--stdin",
        action="store_true",
        help="read the prompt from standard input instead of a file",
    )
    parser.add_argument(
        "--harness",
        choices=HARNESSES,
        help="agent to run; overrides AGENT_HARNESS (default: pi)",
    )
    return parser.parse_args()


def main() -> None:
    args = parse_args()

    harness = resolve_harness(args.harness)
    prompt_file = None if args.stdin else args.prompt.expanduser()
    if prompt_file is None:
        prompt = read_prompt_stdin()
    else:
        prompt = read_prompt_file(prompt_file)

    require_command(harness)
    require_command("plannotator")

    run_dir, run_state = create_run(prompt_file, harness)
    if harness == "pi":
        session_dir = run_dir / PI_SESSION_PATH
        session_dir.mkdir(parents=True)
        output = run_pi(prompt, session_dir, session_file=None)
        session_file = find_pi_session(session_dir)
        run_state["session"] = {
            "kind": "pi-session-file",
            "path": str(session_file.relative_to(run_dir)),
        }
    elif harness == "claude":
        session_id = str(uuid4())
        output = run_claude(prompt, session_id=session_id, resume=False)
        transcript = find_claude_session(session_id)
        run_state["session"] = {
            "kind": "claude-session-id",
            "id": session_id,
            "transcript": str(transcript) if transcript is not None else None,
        }
    else:
        output, session_id = run_opencode(prompt, session_id=None)
        run_state["session"] = opencode_session(session_id)
    write_run_state(run_dir, run_state)
    review_file = run_dir / "response.md"

    while True:
        result = request_review(output, review_file)
        decision = result.get("decision")

        if decision in {"approved", "dismissed"}:
            run_state["status"] = "completed"
            run_state["decision"] = decision
            run_state["completedAt"] = utc_now()
            write_run_state(run_dir, run_state)
            sys.stdout.write(output)
            return
        if decision != "annotated":
            die(f"unknown plannotator decision: {decision!r}")

        feedback = result.get("feedback")
        if not isinstance(feedback, str) or not feedback.strip():
            die("plannotator returned an annotation without feedback")
        revision = revision_prompt(feedback, prompt_file, review_file)
        if harness == "pi":
            output = run_pi(revision, session_dir, session_file=session_file)
        elif harness == "claude":
            output = run_claude(revision, session_id=session_id, resume=True)
        else:
            if session_id is None:
                die("opencode did not report a session id, cannot revise")
            output, _ = run_opencode(revision, session_id=session_id)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nInterrupted", file=sys.stderr)
        raise SystemExit(130) from None
