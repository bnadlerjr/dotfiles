#!/usr/bin/env -S uv run --script
# vim: set filetype=python :
#
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///

"""Iteratively review and revise an agent-generated plan with Plannotator.

Usage:
    plan-loop --prompt <prompt.md>
    plan-loop --stdin < prompt.md
    plan-loop --harness claude --prompt <prompt.md>
    plan-loop --harness opencode --prompt <prompt.md>

The prompt is a Jinja template, read from a file or from standard input and
rendered by ``render-prompt`` with the selected harness name available as
``harness``. The rendered prompt is sent to the harness by ``run-agent``, which
also keeps the harness session so a revision continues the same conversation. The
response is opened in Plannotator. If annotations are submitted, their feedback is
sent back to the same harness session and the complete revised response is opened
for review again. The loop ends when the response is approved or dismissed. The
final response is written to stdout; harness progress and tool activity are
written to stderr.

The --harness option selects the agent: pi, claude, or opencode. The option has
priority. If the option is absent, the AGENT_HARNESS environment variable selects
the agent. If that variable is empty or unset, the harness is pi.

Each invocation stores its run metadata and reviewed response under:

    ${XDG_STATE_HOME:-~/.local/state}/plan-loop/runs/<run-id>/

``run-agent`` records the harness session in session.json in that directory.

Plannotator revision history works within a run because every response revision
reuses that run's response.md path. Run state is retained after the command
exits and may contain sensitive prompts, responses, feedback, and tool results.
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path
from typing import NoReturn
from uuid import uuid4


HARNESSES = ("pi", "claude", "opencode")


def die(message: str, exit_code: int = 1) -> NoReturn:
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(exit_code)


def require_command(name: str) -> None:
    if shutil.which(name) is None:
        die(f"'{name}' not found in PATH")


def utc_now() -> str:
    return datetime.now(timezone.utc).isoformat()


def resolve_harness(selected: str | None) -> str:
    if selected is not None:
        return selected
    configured = os.environ.get("AGENT_HARNESS", "").strip()
    if not configured:
        return "pi"
    if configured not in HARNESSES:
        die(
            f"AGENT_HARNESS must be one of {', '.join(HARNESSES)}, "
            f"not {configured!r}"
        )
    return configured


def run_child(command: list[str], message: str | None = None) -> str:
    # Without a message the child inherits this command's stdin, which is what
    # render-prompt needs to read a template from it.
    result = subprocess.run(
        command, input=message, text=True, stdout=subprocess.PIPE, check=False
    )
    if result.returncode != 0:
        # The child already named the failure; a second line here would report
        # one problem twice.
        raise SystemExit(result.returncode)
    return result.stdout


def render_prompt(prompt_file: Path | None, harness: str) -> str:
    command = ["render-prompt", "--harness", harness]
    if prompt_file is not None:
        command.extend(["--", str(prompt_file)])
    return run_child(command)


def run_agent(message: str, harness: str, handle: Path) -> str:
    # The message is passed on stdin rather than inherited, because this
    # command's own stdin may already be the consumed --stdin prompt.
    return run_child(
        ["run-agent", "--harness", harness, "--session", str(handle)], message
    )


def create_run(
    prompt_file: Path | None, harness: str
) -> tuple[Path, dict[str, object]]:
    state_home = Path(
        os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")
    ).expanduser()
    run_id = str(uuid4())
    run_dir = state_home / "plan-loop" / "runs" / run_id
    run_dir.mkdir(mode=0o700, parents=True)

    state: dict[str, object] = {
        "version": 1,
        "id": run_id,
        "harness": harness,
        "status": "running",
        "createdAt": utc_now(),
        "cwd": str(Path.cwd()),
        "promptFile": str(prompt_file.resolve()) if prompt_file is not None else None,
    }
    write_run_state(run_dir, state)
    return run_dir, state


def write_run_state(run_dir: Path, state: dict[str, object]) -> None:
    destination = run_dir / "run.json"
    temporary = run_dir / ".run.json.tmp"
    temporary.write_text(json.dumps(state, indent=2, ensure_ascii=False) + "\n")
    temporary.replace(destination)


def revision_prompt(feedback: str, prompt_file: Path | None, review_file: Path) -> str:
    protected = f"the annotated response file ({review_file})"
    if prompt_file is not None:
        protected += f" or the source prompt file ({prompt_file})"

    return f"""The text below is review feedback on your previous assistant response.
Revise that response and return the complete replacement as your final assistant
message. Do not edit {protected}. You may still use tools and modify other
project files when needed to fulfill the original task. Do not wrap the complete
response in a Markdown code fence.

{feedback}"""


def request_review(output: str, review_file: Path) -> dict[str, object]:
    review_file.write_text(output)
    result = subprocess.run(
        ["plannotator", "annotate", str(review_file), "--gate", "--json"],
        text=True,
        stdout=subprocess.PIPE,
        check=False,
    )
    if result.returncode != 0:
        die(
            f"plannotator exited with status {result.returncode}",
            result.returncode,
        )

    try:
        decision = json.loads(result.stdout)
    except json.JSONDecodeError:
        die("plannotator returned invalid JSON")
    if not isinstance(decision, dict):
        die("plannotator returned an unexpected result")
    return decision


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog=Path(sys.argv[0]).name,
        description=(
            "Iteratively review and revise an agent-generated plan with Plannotator."
        ),
    )
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument(
        "--prompt",
        type=Path,
        metavar="FILE",
        help=(
            "Jinja template holding the prompt; the selected harness name is "
            "available as 'harness'"
        ),
    )
    source.add_argument(
        "--stdin",
        action="store_true",
        help=(
            "read the Jinja prompt template from standard input; the selected "
            "harness name is available as 'harness'"
        ),
    )
    parser.add_argument(
        "--harness",
        choices=HARNESSES,
        help="agent to run; overrides AGENT_HARNESS (default: pi)",
    )
    return parser.parse_args()


def main() -> None:
    args = parse_args()

    harness = resolve_harness(args.harness)
    prompt_file = None if args.stdin else args.prompt.expanduser()

    # Checked before anything is rendered or written, so a missing command
    # cannot leave a run directory behind.
    require_command(harness)
    require_command("plannotator")
    require_command("render-prompt")
    require_command("run-agent")

    prompt = render_prompt(prompt_file, harness)

    run_dir, run_state = create_run(prompt_file, harness)
    handle = run_dir / "session.json"
    review_file = run_dir / "response.md"

    output = run_agent(prompt, harness, handle)

    while True:
        result = request_review(output, review_file)
        decision = result.get("decision")

        if decision in {"approved", "dismissed"}:
            run_state["status"] = "completed"
            run_state["decision"] = decision
            run_state["completedAt"] = utc_now()
            write_run_state(run_dir, run_state)
            sys.stdout.write(output)
            return
        if decision != "annotated":
            die(f"unknown plannotator decision: {decision!r}")

        feedback = result.get("feedback")
        if not isinstance(feedback, str) or not feedback.strip():
            die("plannotator returned an annotation without feedback")
        output = run_agent(
            revision_prompt(feedback, prompt_file, review_file), harness, handle
        )


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nInterrupted", file=sys.stderr)
        raise SystemExit(130) from None
