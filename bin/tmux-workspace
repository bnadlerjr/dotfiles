#!/usr/bin/env bash
#
# Create (or attach to) a tmux workspace session for a Jira issue.
#
# Given a Jira issue key, looks up the issue title via the Jira CLI and creates
# a tmux session named "<KEY>-<kebab-title>" (e.g. POPS-1234-add-auth-to-resolver)
# rooted at ~/dev/instinct. Re-running for the same issue attaches to the
# existing session rather than creating a duplicate; matching is by the issue
# key, so a title change in Jira still resolves to the one session.
#
# USAGE:
#   tmux-workspace <ISSUE-KEY>
#
# OPTIONS:
#   Set a DEBUG environment variable (1|yes|true) to enable tracing.
#
# Requires: tmux, jira (configured via `jira init`).

set -euo pipefail
IFS=$'\n\t'

case "${DEBUG-}" in
  1 | yes | true) set -x ;;
esac

SCRIPT_NAME="$(basename "$0")"
readonly SCRIPT_NAME
readonly WORKSPACE_DIR="$HOME/dev/instinct"

die() {
  echo "${SCRIPT_NAME}: error: $*" >&2
  exit 1
}

usage() {
  cat <<EOF
Usage: ${SCRIPT_NAME} <ISSUE-KEY>

Create or attach to a tmux workspace session for a Jira issue.

Arguments:
  ISSUE-KEY    Jira issue key (e.g. POPS-1234). Case-insensitive.

The session is named "<KEY>-<kebab-title>" and rooted at ${WORKSPACE_DIR}.
Re-running for the same issue attaches to the existing session.

Exit codes:
  0  Success
  1  General error (jira unconfigured, issue not found, etc.)
  2  Invalid arguments
EOF
}

# Convert the given string to kebab-case.
# (borrowed from dev_scripts/scripts/git-create-feature-branch)
to_kebab_case() {
  echo "$1" |
    tr '[:upper:]' '[:lower:]' |
    sed 's/[^a-z0-9]/-/g' |
    sed 's/--*/-/g' |
    sed 's/^-//' |
    sed 's/-$//'
}

# Print the summary/title for a Jira issue key.
#
# Returns non-zero if the lookup fails and echoes jira's own diagnostic to
# stderr: jira-cli exits 1 (empty stdout) for both a missing issue AND an
# unconfigured/unreachable CLI, so the exit code alone can't tell them apart —
# surface jira's message ("No result found ..." vs an auth error) instead of
# guessing. Isolated here so another tracker (GitHub, Linear) can be swapped in.
ticket_title() {
  local key="$1" out err
  err=$(mktemp)
  out=$(jira issue list \
    --jql "key=$key" \
    --columns key,summary \
    --plain \
    --no-headers 2>"$err") || {
    cat "$err" >&2
    rm -f "$err"
    return 1
  }
  rm -f "$err"
  # Drop the leading key column, leaving the summary.
  printf '%s\n' "$out" | awk '{$1=""; sub(/^[[:space:]]+/, ""); print}'
}

# Print the name of an existing session for this key, if any. Matches the key
# exactly or as a "<KEY>-..." prefix so a title rename still resolves to it.
existing_session() {
  local key="$1"
  tmux list-sessions -F '#S' 2>/dev/null |
    grep -E "^${key}(-|\$)" |
    head -n 1 || true
}

# Attach to a session, switching the client when already inside tmux to avoid
# nesting. (idiom borrowed from bin/tmuxify.sh)
enter_session() {
  local target="$1"
  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$target"
  else
    tmux attach -t "$target"
  fi
}

main() {
  case "${1:-}" in
    -h | --help) usage; exit 0 ;;
  esac

  [[ $# -eq 1 ]] || { usage >&2; exit 2; }

  command -v jira >/dev/null 2>&1 || die "jira CLI not found on PATH"
  [[ -d "$WORKSPACE_DIR" ]] || die "workspace directory not found: $WORKSPACE_DIR"

  # Normalize to uppercase and validate the PROJECT-NUMBER shape up front.
  local key
  key=$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')
  [[ "$key" =~ ^[A-Z]+-[0-9]+$ ]] || {
    echo "${SCRIPT_NAME}: invalid issue key: '$1' (expected PROJECT-123)" >&2
    exit 2
  }

  # If a session for this issue already exists, just go to it.
  local existing
  existing=$(existing_session "$key")
  if [[ -n "$existing" ]]; then
    enter_session "$existing"
    exit 0
  fi

  # Otherwise resolve the title and create the session. ticket_title has
  # already echoed jira's own error to stderr on failure.
  local title
  title=$(ticket_title "$key") || die "could not resolve $key (see jira error above)"

  local slug session_name
  slug=$(to_kebab_case "$title")
  session_name="${key}-${slug}"
  tmux new-session -ds "$session_name" -c "$WORKSPACE_DIR" -n workspace
  enter_session "$session_name"
}

main "$@"
