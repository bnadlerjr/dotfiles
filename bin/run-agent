#!/usr/bin/env -S uv run --script
# vim: set filetype=python :
#
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///

"""Send one prompt to an agent harness and print the response.

Usage:
    run-agent --harness pi < prompt.md
    run-agent --harness claude --session run/session.json < prompt.md
    run-agent --harness opencode --session run/session.json < prompt.md

The prompt is read from standard input and sent to the selected harness: pi,
claude, or opencode. The response is written to stdout and ends with a newline;
harness progress and tool activity are written to stderr.

Without --session the turn stands alone: the harness session is discarded when
the command exits, and pi keeps its session in a temporary directory. With
--session the session is recorded in that file, and a later invocation with the
same file continues the same conversation. The file is an opaque handle owned by
this command; its parent directory must already exist.

A handle that cannot be read, is not a JSON object, was written for a different
harness, or does not identify a session to resume is an error rather than a
fresh start. Starting over instead would send a follow-up message to an agent
that never saw the conversation the message belongs to.

A pi session lives in a directory beside the handle, named after it. Claude Code
writes its session in its own configuration directory, and the handle records
the session id with the transcript path. opencode keeps its sessions in one
database, and the handle records the session id with the database path.
"""

import argparse
import json
import os
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path
from typing import NoReturn
from uuid import uuid4


HARNESSES = ("pi", "claude", "opencode")

# Per harness: the handle's kind, and the field a resume needs.
HANDLE_KINDS = {
    "pi": ("pi-session-file", "path"),
    "claude": ("claude-session-id", "id"),
    "opencode": ("opencode-session-id", "id"),
}


def die(message: str, exit_code: int = 1) -> NoReturn:
    print(f"error: {message}", file=sys.stderr)
    raise SystemExit(exit_code)


def require_command(name: str) -> None:
    if shutil.which(name) is None:
        die(f"'{name}' not found in PATH")


def read_prompt() -> str:
    try:
        prompt = sys.stdin.read()
    except (OSError, UnicodeError) as error:
        die(f"cannot read prompt from stdin: {error}")
    if not prompt.strip():
        die("prompt is empty")
    return prompt


def read_handle(handle: Path, harness: str) -> dict[str, object] | None:
    kind, resume_field = HANDLE_KINDS[harness]
    if not handle.parent.is_dir():
        die(f"session directory does not exist: {handle.parent}")
    if not handle.exists():
        return None

    try:
        session = json.loads(handle.read_text())
    except (OSError, UnicodeError) as error:
        die(f"cannot read session {handle}: {error}")
    except json.JSONDecodeError as error:
        die(f"session {handle} is not valid JSON: {error}")
    if not isinstance(session, dict):
        die(f"session {handle} is not a JSON object")
    if session.get("kind") != kind:
        die(f"session {handle} was not written for harness {harness}")
    resume_value = session.get(resume_field)
    if resume_value is None:
        die(f"session {handle} does not identify a session to resume")
    if not isinstance(resume_value, str) or not resume_value.strip():
        die(f"session {handle} holds an unusable {resume_field}")
    return session


def write_handle(handle: Path, session: dict[str, object]) -> None:
    temporary = handle.with_name(f".{handle.name}.tmp")
    try:
        temporary.write_text(json.dumps(session, indent=2, ensure_ascii=False) + "\n")
        temporary.replace(handle)
    except OSError as error:
        die(f"cannot write session {handle}: {error}")


def opencode_database() -> Path | None:
    data_home = Path(
        os.environ.get("XDG_DATA_HOME", Path.home() / ".local" / "share")
    ).expanduser()
    database = data_home / "opencode" / "opencode.db"
    # opencode owns this file, so a missing database must not end the turn.
    return database if database.is_file() else None


def find_pi_session(session_dir: Path) -> Path:
    sessions = list(session_dir.glob("*.jsonl"))
    if len(sessions) != 1:
        die(f"expected one pi session in {session_dir}, found {len(sessions)}")
    return sessions[0]


def find_claude_session(session_id: str) -> Path | None:
    config_home = Path(
        os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude")
    ).expanduser()
    transcripts = list((config_home / "projects").glob(f"*/{session_id}.jsonl"))
    # Claude Code owns the transcript and may not have written it yet, so a
    # missing one must not end the turn: the id alone resumes the session.
    if len(transcripts) != 1:
        return None
    return transcripts[0]


def assistant_text(event: dict[str, object]) -> str | None:
    message = event.get("message")
    if not isinstance(message, dict) or message.get("role") != "assistant":
        return None

    content = message.get("content")
    if isinstance(content, str):
        return content
    if not isinstance(content, list):
        return None

    return "".join(
        block.get("text", "")
        for block in content
        if isinstance(block, dict)
        and block.get("type") == "text"
        and isinstance(block.get("text"), str)
    )


def truncated_args(args: object) -> str:
    details = json.dumps(args, ensure_ascii=False, separators=(",", ":"))
    if len(details) > 500:
        details = f"{details[:497]}..."
    return details


def describe_tool_call(harness: str, name: object, args: object) -> None:
    print(
        f"[{harness}] → {name} {truncated_args(args)}", file=sys.stderr, flush=True
    )


def message_blocks(event: dict[str, object]) -> list[dict[str, object]]:
    message = event.get("message")
    if not isinstance(message, dict):
        return []
    content = message.get("content")
    if not isinstance(content, list):
        return []
    return [block for block in content if isinstance(block, dict)]


def start_harness(command: list[str], message: str) -> "subprocess.Popen[str]":
    process = subprocess.Popen(
        command,
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        text=True,
        bufsize=1,
    )
    assert process.stdin is not None
    assert process.stdout is not None
    process.stdin.write(message)
    process.stdin.close()
    return process


def run_pi(message: str, session_dir: Path, *, session_file: Path | None) -> str:
    command = ["pi", "--mode", "json", "--session-dir", str(session_dir)]
    if session_file is not None:
        command.extend(["--session", str(session_file)])

    process = start_harness(command, message)
    assert process.stdout is not None

    print("[pi] working...", file=sys.stderr, flush=True)
    output: str | None = None
    thinking_active = False
    thinking_ends_with_newline = False
    for line in process.stdout:
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            process.terminate()
            die("pi returned an invalid JSON event")
        if not isinstance(event, dict):
            continue

        event_type = event.get("type")
        if event_type == "message_update":
            update = event.get("assistantMessageEvent")
            if not isinstance(update, dict):
                continue
            update_type = update.get("type")
            if update_type == "thinking_start":
                sys.stderr.write("[pi] thinking: ")
                sys.stderr.flush()
                thinking_active = True
                thinking_ends_with_newline = False
            elif update_type == "thinking_delta":
                delta = update.get("delta")
                if not isinstance(delta, str):
                    continue
                if not thinking_active:
                    sys.stderr.write("[pi] thinking: ")
                    thinking_active = True
                sys.stderr.write(delta)
                sys.stderr.flush()
                thinking_ends_with_newline = delta.endswith("\n")
            elif update_type == "thinking_end" and thinking_active:
                if not thinking_ends_with_newline:
                    sys.stderr.write("\n")
                sys.stderr.flush()
                thinking_active = False
        elif event_type == "tool_execution_start":
            describe_tool_call(
                "pi", event.get("toolName", "unknown"), event.get("args")
            )
        elif event_type == "tool_execution_end":
            name = event.get("toolName", "unknown")
            status = "failed" if event.get("isError") else "done"
            print(f"[pi] ← {name} {status}", file=sys.stderr, flush=True)
        elif event_type == "message_end":
            text = assistant_text(event)
            if text is not None:
                output = text

    if thinking_active and not thinking_ends_with_newline:
        sys.stderr.write("\n")
        sys.stderr.flush()

    return_code = process.wait()
    if return_code != 0:
        die(f"pi exited with status {return_code}", return_code)
    if output is None or not output.strip():
        die("pi returned an empty response")
    return output


def run_claude(message: str, *, session_id: str, resume: bool) -> str:
    command = [
        "claude",
        "-p",
        "--output-format",
        "stream-json",
        "--verbose",
        "--safe-mode",
        "--permission-mode",
        "dontAsk",
    ]
    command.extend(["--resume", session_id] if resume else ["--session-id", session_id])

    process = start_harness(command, message)
    assert process.stdout is not None

    print("[claude] working...", file=sys.stderr, flush=True)
    output: str | None = None
    tool_names: dict[object, object] = {}
    for line in process.stdout:
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            process.terminate()
            die("claude returned an invalid JSON event")
        if not isinstance(event, dict):
            continue

        event_type = event.get("type")
        if event_type == "assistant":
            for block in message_blocks(event):
                if block.get("type") != "tool_use":
                    continue
                name = block.get("name", "unknown")
                tool_names[block.get("id")] = name
                describe_tool_call("claude", name, block.get("input"))
        elif event_type == "user":
            for block in message_blocks(event):
                if block.get("type") != "tool_result":
                    continue
                name = tool_names.get(block.get("tool_use_id"), "unknown")
                # A successful tool result omits is_error.
                status = "failed" if block.get("is_error") else "done"
                print(f"[claude] ← {name} {status}", file=sys.stderr, flush=True)
        elif event_type == "result":
            text = event.get("result")
            if event.get("is_error"):
                process.terminate()
                die(f"claude reported an error: {text}")
            if isinstance(text, str):
                output = text

    return_code = process.wait()
    if return_code != 0:
        die(f"claude exited with status {return_code}", return_code)
    if output is None or not output.strip():
        die("claude returned an empty response")
    return output


def opencode_error(event: dict[str, object]) -> str:
    error = event.get("error")
    if not isinstance(error, dict):
        return "unknown error"
    data = error.get("data")
    message = data.get("message") if isinstance(data, dict) else None
    name = error.get("name", "error")
    return f"{name}: {message}" if message else str(name)


def run_opencode(message: str, *, session_id: str | None) -> tuple[str, str | None]:
    command = ["opencode", "run", "--format", "json", "--pure", "--auto"]
    if session_id is not None:
        command.extend(["-s", session_id])

    process = start_harness(command, message)
    assert process.stdout is not None

    print("[opencode] working...", file=sys.stderr, flush=True)
    # opencode mints the session id itself and reports it in its events, so a
    # new session's id is captured from the stream rather than passed in.
    captured = session_id
    output = ""
    text_message = None
    for line in process.stdout:
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            process.terminate()
            die("opencode returned an invalid JSON event")
        if not isinstance(event, dict):
            continue

        reported = event.get("sessionID")
        if isinstance(reported, str):
            captured = reported
        part = event.get("part")
        if not isinstance(part, dict):
            part = {}

        event_type = event.get("type")
        if event_type == "text":
            # Text arrives per message, and a new message replaces the answer
            # rather than extending it.
            if part.get("messageID") != text_message:
                text_message = part.get("messageID")
                output = ""
            text = part.get("text")
            if isinstance(text, str):
                output += text
        elif event_type == "tool_use":
            state = part.get("state")
            if not isinstance(state, dict):
                state = {}
            status = state.get("status", "unknown")
            print(
                f"[opencode] ← {part.get('tool', 'unknown')} "
                f"{'done' if status == 'completed' else status} "
                f"{truncated_args(state.get('input'))}",
                file=sys.stderr,
                flush=True,
            )
        elif event_type == "error":
            process.terminate()
            die(f"opencode reported an error: {opencode_error(event)}")

    return_code = process.wait()
    if return_code != 0:
        die(f"opencode exited with status {return_code}", return_code)
    if not output.strip():
        die("opencode returned an empty response")
    return output, captured


def resume_pi_session(handle: Path, recorded: str) -> Path:
    path = Path(recorded)
    if path.is_absolute() or ".." in path.parts:
        die(f"session recorded in {handle} is not inside {handle.parent}: {recorded}")
    session_file = handle.parent / path
    # pi treats a session path it cannot find as a new session, so resuming a
    # missing one would continue the old conversation in name only.
    if not session_file.is_file():
        die(f"session recorded in {handle} is missing: {session_file}")
    return session_file


def turn_pi(
    prompt: str, handle: Path | None, session: dict[str, object] | None
) -> str:
    if handle is None:
        with tempfile.TemporaryDirectory() as temporary:
            return run_pi(prompt, Path(temporary), session_file=None)

    session_file = (
        None if session is None else resume_pi_session(handle, str(session["path"]))
    )
    session_dir = handle.parent / f"{handle.stem}-pi"
    try:
        session_dir.mkdir(parents=True, exist_ok=True)
    except OSError as error:
        die(f"cannot create {session_dir}: {error}")
    output = run_pi(prompt, session_dir, session_file=session_file)
    if session_file is None:
        session_file = find_pi_session(session_dir)
    write_handle(
        handle,
        {
            "kind": "pi-session-file",
            "path": str(session_file.relative_to(handle.parent)),
        },
    )
    return output


def turn_claude(
    prompt: str, handle: Path | None, session: dict[str, object] | None
) -> str:
    resume = session is not None
    session_id = str(session["id"]) if resume else str(uuid4())
    output = run_claude(prompt, session_id=session_id, resume=resume)
    if handle is not None:
        transcript = find_claude_session(session_id)
        write_handle(
            handle,
            {
                "kind": "claude-session-id",
                "id": session_id,
                "transcript": str(transcript) if transcript is not None else None,
            },
        )
    return output


def turn_opencode(
    prompt: str, handle: Path | None, session: dict[str, object] | None
) -> str:
    session_id = None if session is None else str(session["id"])
    output, captured = run_opencode(prompt, session_id=session_id)
    if handle is not None:
        database = opencode_database()
        # Recorded even when opencode reported no id: the handle is what tells a
        # later turn that a session exists but cannot be resumed, instead of
        # letting it quietly start a new conversation.
        write_handle(
            handle,
            {
                "kind": "opencode-session-id",
                "id": captured,
                "database": str(database) if database is not None else None,
            },
        )
    return output


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        prog=Path(sys.argv[0]).name,
        description="Send one prompt to an agent harness and print the response.",
    )
    parser.add_argument(
        "--harness",
        choices=HARNESSES,
        required=True,
        help="agent the prompt is sent to",
    )
    parser.add_argument(
        "--session",
        type=Path,
        metavar="PATH",
        help=(
            "file holding the harness session, so a later invocation continues "
            "the same conversation (default: discard the session)"
        ),
    )
    return parser.parse_args()


def main() -> None:
    args = parse_args()

    # The handle is checked before the prompt is read, so a bad one is reported
    # without first waiting on stdin.
    require_command(args.harness)
    handle = None if args.session is None else args.session.expanduser()
    session = None if handle is None else read_handle(handle, args.harness)

    prompt = read_prompt()

    turns = {"pi": turn_pi, "claude": turn_claude, "opencode": turn_opencode}
    output = turns[args.harness](prompt, handle, session)

    sys.stdout.write(output if output.endswith("\n") else output + "\n")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nInterrupted", file=sys.stderr)
        raise SystemExit(130) from None
